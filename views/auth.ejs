<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Begin — Onboarding: minimum profile</title>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">/** @type {import('tailwindcss').Config} */
globalThis.tailwind = globalThis.tailwind || {};
globalThis.tailwind.config = {
  darkMode: 'class',
  theme: {
    extend: {
      colors: {
        'primary': '#111111',
        'on-primary': '#FFFFFF',
        'primary-deep': '#111111',
        'primary-container': '#F5F5F5',
        'on-primary-container': '#111111',
        'secondary': '#F5F5F5',
        'on-secondary': '#111111',
        'surface': '#FFFFFF',
        'on-surface': '#111111',
        'surface-container-low': '#F5F5F5',
        'surface-container': '#F5F5F5',
        'surface-container-high': '#E5E5E5',
        'on-surface-variant': '#707072',
        'outline': '#CACACB',
        'outline-variant': '#E5E5E5',
        'surface-code': '#111111',
        'on-dark': '#FFFFFF',
        'error': '#D30005',
        'on-error': '#FFFFFF',
        'success': '#007D48',
        'on-success': '#FFFFFF',
        'warning': '#D97706',
        'on-warning': '#111111',
        'accent-emerald': '#007D48',
        'accent-emerald-bg': '#ECFDF5',
        'on-accent-emerald': '#ECEFEE',
        'accent-amber': '#D97706',
        'accent-amber-bg': '#FFFBEB',
        'on-accent-amber': '#461F07',
        'accent-violet': '#7C3AED',
        'accent-violet-bg': '#F5F3FF',
        'on-accent-violet': '#E7E3ED',
        'accent-rose': '#D30005',
        'accent-rose-bg': '#FFF1F2',
        'on-accent-rose': '#FBFAFA',
        'accent-teal': '#0A7281',
        'accent-teal-bg': '#F0FDFA',
        'on-accent-teal': '#E4E7E6',
      },
      borderRadius: {
        'sm': '4px',
        'DEFAULT': '0px',
        'md': '24px',
        'lg': '0px',
        'xl': '12px',
        'full': '9999px',
      },
      spacing: {
        'gutter-xs': '4px',
        'gutter-sm': '8px',
        'gutter-md': '16px',
        'gutter-lg': '24px',
        'gutter-xl': '32px',
        'section': '48px',
        'page-margin': '24px',
      },
      fontFamily: {
        'display': ['"Instrument Serif"', 'sans-serif'],
        'headline': ['"Instrument Serif"', 'sans-serif'],
        'title': ['"Inter"', 'sans-serif'],
        'body': ['"Inter"', 'sans-serif'],
        'label': ['"Inter"', 'sans-serif'],
        'mono': ['"JetBrains Mono"', 'monospace'],
      },
      fontSize: {
        'display-lg': ['56px', { lineHeight: '60px', letterSpacing: '-1.2px', fontWeight: '400' }],
        'display-lg-mobile': ['38px', { lineHeight: '42px', letterSpacing: '-0.8px', fontWeight: '400' }],
        'headline-lg': ['40px', { lineHeight: '44px', letterSpacing: '-0.8px', fontWeight: '400' }],
        'headline-lg-mobile': ['30px', { lineHeight: '34px', letterSpacing: '-0.5px', fontWeight: '400' }],
        'headline-md': ['28px', { lineHeight: '32px', letterSpacing: '-0.4px', fontWeight: '400' }],
        'headline-sm': ['20px', { lineHeight: '26px', letterSpacing: '-0.3px', fontWeight: '600' }],
        'title-md': ['16px', { lineHeight: '22px', letterSpacing: '-0.2px', fontWeight: '600' }],
        'body-lg': ['16px', { lineHeight: '25px', letterSpacing: '0px', fontWeight: '400' }],
        'body-md': ['14px', { lineHeight: '22px', letterSpacing: '0px', fontWeight: '400' }],
        'body-sm': ['12px', { lineHeight: '18px', letterSpacing: '0px', fontWeight: '400' }],
        'label-lg': ['14px', { lineHeight: '20px', letterSpacing: '-0.1px', fontWeight: '500' }],
        'label-md': ['12px', { lineHeight: '16px', letterSpacing: '0px', fontWeight: '500' }],
        'label-sm': ['11px', { lineHeight: '14px', letterSpacing: '0.3px', fontWeight: '500' }],
        'mono-md': ['14px', { lineHeight: '20px', letterSpacing: '0px', fontWeight: '500' }],
        'mono-sm': ['12px', { lineHeight: '16px', letterSpacing: '0px', fontWeight: '400' }],
      },
      transitionDuration: {
        'state-change': '150ms',
        'surface-enter': '220ms',
        'surface-exit': '150ms',
      },
      transitionDelay: {
        'state-change': '0ms',
        'surface-enter': '0ms',
        'surface-exit': '0ms',
      },
      transitionTimingFunction: {
        'state-change': 'ease-out',
        'surface-enter': 'cubic-bezier(0.2, 0, 0, 1)',
        'surface-exit': 'cubic-bezier(0.3, 0, 1, 1)',
      },
    },
  },
};
if (typeof module !== 'undefined') module.exports = globalThis.tailwind.config;
</script>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&amp;family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
  <style>
    .material-symbols-outlined, .material-symbols-rounded, .material-symbols-sharp, .material-icons { display: inline-block; width: 1em; height: 1em; line-height: 1 !important; box-sizing: content-box; overflow: hidden; white-space: nowrap; direction: ltr; vertical-align: middle; }
    .hero-scrim {
      background: linear-gradient(180deg, rgba(26, 25, 24, 0.72) 0%, rgba(26, 25, 24, 0.62) 45%, rgba(26, 25, 24, 0.88) 100%);
    }
    .panel-row-divider {
      border-color: rgba(255, 255, 255, 0.14);
    }
    .panel-list-card {
      background: rgba(26, 25, 24, 0.56);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .btn-corporate-gradient {
      background: radial-gradient(120% 140% at 88% 12%, #3B3734 0%, #1C1B1A 45%, #111113 100%);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 1px 3px rgba(0, 0, 0, 0.16);
    }
    .btn-corporate-gradient:hover {
      background: radial-gradient(120% 140% at 88% 12%, #47423E 0%, #232220 45%, #161618 100%);
    }
    [hidden] { display: none !important; }
  </style>
</head>
<body class="bg-surface text-on-surface font-body antialiased selection:bg-primary selection:text-on-primary">
  <div class="min-h-screen grid grid-cols-1 lg:grid-cols-12" data-stitch-vh="min-h-[1024px]===min-h-screen">

    <!-- Left Corporate Gradient Brand Sidebar (Exact replica of code (2).html) -->
    <aside class="lg:col-span-5 relative overflow-hidden bg-on-surface text-surface border-b lg:border-b-0 lg:border-r border-outline flex flex-col justify-between p-gutter-lg sm:p-10 lg:p-12">
      <!-- Background Image extracted directly from code (2).html -->
      <img src="/code2-bg.png" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover">
      <div class="absolute inset-0 hero-scrim" aria-hidden="true"></div>

      <!-- Top Brand Mark -->
      <div class="relative z-10 flex items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center bg-surface px-2.5 py-1 rounded-md shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-surface" aria-label="Begin home">
          <img src="/code2-logo.png" alt="Begin" class="h-6 w-20 object-cover object-center">
        </a>
        <span class="font-mono text-label-sm text-surface bg-on-surface border border-outline-variant px-2.5 py-1 rounded-full" data-design-text-token="label-sm">Campus Beta</span>
      </div>

      <!-- Middle Headline & Value Props -->
      <div class="relative z-10 my-10 lg:my-0 flex flex-col gap-gutter-lg">
        <div class="flex flex-col gap-3">
          <h1 data-component-id="typography-display-on-dark" data-component-type="typography" data-component-variant="display" data-design-text-token="display-lg" class="font-display text-display-lg-mobile md:text-display-lg text-surface text-balance">Where our campus builds startups.</h1>
          <p data-component-id="typography-body-on-dark" data-component-type="typography" data-component-variant="body" data-design-text-token="body-lg" class="font-body text-body-lg text-surface-container text-pretty max-w-prose">Find co-founders, show your work, and get feedback from builders at your college.</p>
        </div>

        <!-- 3 Core Value Pillars -->
        <ul class="flex flex-col rounded-lg panel-list-card divide-y panel-row-divider" aria-label="Community highlights">
          <li class="flex items-center gap-3.5 p-4">
            <span class="w-9 h-9 rounded-md bg-accent-violet-bg text-accent-violet flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">handshake</span>
            </span>
            <div class="flex flex-col gap-0.5">
              <span class="font-title text-title-md text-surface" data-design-text-token="title-md">Find a co-founder</span>
              <span class="font-body text-body-sm text-surface-container" data-design-text-token="body-sm">Skill-based discovery and an Open Roles board</span>
            </div>
          </li>

          <li class="flex items-center gap-3.5 p-4 panel-row-divider">
            <span class="w-9 h-9 rounded-md bg-accent-emerald-bg text-accent-emerald flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">rocket_launch</span>
            </span>
            <div class="flex flex-col gap-0.5">
              <span class="font-title text-title-md text-surface" data-design-text-token="title-md">Join a project</span>
              <span class="font-body text-body-sm text-surface-container" data-design-text-token="body-sm">Apply to roles that match your skills</span>
            </div>
          </li>

          <li class="flex items-center gap-3.5 p-4 panel-row-divider">
            <span class="w-9 h-9 rounded-md bg-accent-amber-bg text-on-accent-amber flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">verified_user</span>
            </span>
            <div class="flex flex-col gap-0.5">
              <span class="font-title text-title-md text-surface" data-design-text-token="title-md">Verified students only</span>
              <span class="font-body text-body-sm text-surface-container" data-design-text-token="body-sm">College email required</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Bottom Attribution -->
      <div class="relative z-10 flex items-center justify-between gap-4 pt-4 border-t panel-row-divider">
        <span id="aside-bottom-link" class="font-mono text-mono-sm text-surface-container" data-design-text-token="mono-sm">begin.college.edu/profile</span>
        <span id="aside-bottom-status" class="font-mono text-mono-sm text-surface-container tabular-nums" data-design-text-token="mono-sm">Step 2 of 2</span>
      </div>
    </aside>


    <!-- Right White Workspace -->
    <main class="lg:col-span-7 bg-surface flex flex-col justify-between gap-6 p-gutter-lg sm:p-10 lg:p-12">

      <!-- ========================================================================= -->
      <!-- STEP 1 HEADER: Join / Sign in                                             -->
      <!-- ========================================================================= -->
      <header id="step1-header" class="flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-1.5 font-label text-label-md text-on-surface-variant hover:text-on-surface transition-colors duration-state-change ease-state-change focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary rounded-sm" data-design-text-token="label-md">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_back</span>
          <span>Back to campus feed</span>
        </a>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface-variant border border-outline font-mono text-label-sm" data-design-text-token="label-sm">
          Campus Beta · Step 1 of 2
        </span>
      </header>

      <!-- ========================================================================= -->
      <!-- STEP 2 HEADER: OTP Verification (matches code (3).html)                   -->
      <!-- ========================================================================= -->
      <header id="step2-header" hidden class="flex items-center justify-between gap-4">
        <button id="verify-change-email-btn" type="button" class="inline-flex items-center gap-1.5 font-label text-label-md text-on-surface-variant hover:text-on-surface transition-colors duration-state-change ease-state-change focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary rounded-sm" data-design-text-token="label-md">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_back</span>
          <span>Change email</span>
        </button>

        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface-variant border border-outline font-mono text-label-sm" data-design-text-token="label-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-emerald"></span>
          Code active
        </span>
      </header>

      <!-- ========================================================================= -->
      <!-- STEP 3 HEADER: Minimum Profile (matches code (2).html verbatim)           -->
      <!-- ========================================================================= -->
      <header id="step3-header" hidden class="flex flex-wrap items-center justify-between gap-4">
        <a id="step3-back-btn" href="/role?email=<%= encodeURIComponent(email) %>" class="inline-flex items-center gap-1.5 font-label text-label-md text-on-surface-variant hover:text-on-surface transition-colors duration-state-change ease-state-change focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary rounded-sm" data-design-text-token="label-md">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_back</span>
          <span>Back to role</span>
        </a>

        <nav aria-label="Onboarding progress" class="flex items-center gap-1.5">
          <a id="nav-pill-role" href="/role?email=<%= encodeURIComponent(email) %>" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-accent-emerald-bg text-accent-emerald font-mono text-label-sm" data-design-text-token="label-sm">
            <span class="material-symbols-outlined text-[14px]" aria-hidden="true">check_circle</span>
            <span>1. Role</span>
          </a>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-primary text-on-primary font-mono text-label-sm" data-design-text-token="label-sm">2. Profile</span>
        </nav>
      </header>


      <!-- ========================================================================= -->
      <!-- STEP 1 VIEW: Email Entry (Signup / Login tab from code (1).html)         -->
      <!-- ========================================================================= -->
      <section id="step1-view" class="w-full max-w-[460px] mx-auto flex flex-col gap-6" aria-label="Email sign in and registration">
        <!-- Segmented Tab Switcher (Signup default, Login second) -->
        <div class="w-full p-1 rounded-md bg-surface-container-low border border-outline flex items-center gap-1" role="tablist" aria-label="Authentication mode">
          <button id="tab-signup" type="button" role="tab" aria-selected="true" class="flex-1 py-1.5 rounded-sm font-label text-label-md transition-colors duration-state-change ease-state-change bg-surface text-on-surface shadow-sm font-medium" data-design-text-token="label-md">
            Sign up
          </button>
          <button id="tab-login" type="button" role="tab" aria-selected="false" class="flex-1 py-1.5 rounded-sm font-label text-label-md transition-colors duration-state-change ease-state-change text-on-surface-variant hover:text-on-surface" data-design-text-token="label-md">
            Log in
          </button>
        </div>

        <div class="flex flex-col gap-1">
          <h2 id="auth-heading" class="font-display text-headline-lg-mobile md:text-headline-lg text-on-surface text-balance" data-design-text-token="headline-lg">Create your student builder account</h2>
          <p id="auth-subheading" class="font-body text-body-md text-on-surface-variant text-pretty" data-design-text-token="body-md">Use your Gmail or email address to get started.</p>
        </div>

        <!-- Google Auth Button (Continue with Google / Google Identity Services) -->
        <div id="google-gsi-wrapper" class="w-full flex flex-col items-center gap-2">
          <!-- Real Google One-Tap / GSI rendered button (Active when GOOGLE_CLIENT_ID is set in .env) -->
          <div id="g_id_signin" class="w-full flex justify-center"></div>

          <!-- Direct Google Auth Button -->
          <button id="google-auth-btn" type="button" class="w-full inline-flex items-center justify-center gap-3 px-4 py-2.5 rounded-md bg-surface border border-outline hover:bg-surface-container-low hover:border-outline-variant font-label text-label-lg text-on-surface shadow-sm transition-colors duration-state-change ease-state-change focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span id="google-btn-text" data-design-text-token="label-lg">Sign up with Google</span>
          </button>
        </div>

        <!-- Divider with Text -->
        <div class="relative flex items-center justify-center my-1">
          <div class="w-full border-t border-outline"></div>
          <span class="absolute bg-surface px-3 font-body text-body-sm text-on-surface-variant uppercase tracking-wider text-[11px]">or with email</span>
        </div>

        <form id="email-form" class="flex flex-col gap-4" novalidate>
          <div class="flex flex-col gap-1.5">
            <label for="college-email" class="font-label text-label-md text-on-surface" data-design-text-token="label-md">Email address</label>
            <input id="college-email" name="email" type="email" autocomplete="email" required placeholder="you@gmail.com or your email" class="w-full px-3.5 py-2.5 rounded-md bg-surface text-on-surface border border-outline placeholder:text-on-surface-variant focus:border-primary focus:ring-1 focus:ring-primary font-body text-body-md transition-colors duration-state-change ease-state-change">
            <span class="font-body text-body-sm text-on-surface-variant" data-design-text-token="body-sm">All Gmail and email addresses are accepted.</span>
          </div>

          <!-- Email Error Alert (HIGH CONTRAST RED) -->
          <div id="email-error" role="alert" hidden class="px-3.5 py-2.5 rounded-md bg-red-50 border border-error flex items-center gap-2.5 text-error">
            <span class="material-symbols-outlined text-[18px] text-error shrink-0" aria-hidden="true">error_outline</span>
            <span class="font-body text-body-sm text-error font-medium" data-design-text-token="body-sm"></span>
          </div>

          <button id="send-otp-btn" type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-primary btn-corporate-gradient text-on-primary font-label text-label-lg shadow-sm hover:opacity-90 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-colors duration-state-change ease-state-change">
            <span data-design-text-token="label-lg">Send verification code</span>
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
          </button>
        </form>
      </section>


      <!-- ========================================================================= -->
      <!-- STEP 2 VIEW: OTP Verification (Exact replica of code (3).html)            -->
      <!-- ========================================================================= -->
      <section id="step2-view" hidden class="w-full max-w-[460px] mx-auto flex flex-col gap-6" aria-label="Enter verification code">
        <div class="flex flex-col gap-1">
          <h2 class="font-display text-headline-lg-mobile md:text-headline-lg text-on-surface text-balance" data-design-text-token="headline-lg">Check your inbox</h2>
          <p class="font-body text-body-md text-on-surface-variant text-pretty" data-design-text-token="body-md">
            We sent a 6-digit verification code to
            <span id="verify-email-target" class="font-medium text-on-surface underline decoration-outline">you@college.edu</span>.
            Enter it below to continue.
          </p>
        </div>

        <form id="verify-form" class="flex flex-col gap-4" novalidate>
          <div class="flex flex-col gap-1.5">
            <label class="font-label text-label-md text-on-surface" data-design-text-token="label-md">6-digit verification code</label>
            <div class="grid grid-cols-6 gap-2 sm:gap-2.5" role="group" aria-label="Verification code digits">
              <input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" data-otp-input="0" autofocus class="w-full aspect-square text-center font-mono text-mono-md text-on-surface bg-surface-container-low border border-outline rounded-md focus:border-primary focus:ring-1 focus:ring-primary focus:bg-surface transition-colors duration-state-change ease-state-change" aria-label="Digit 1">
              <input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" data-otp-input="1" class="w-full aspect-square text-center font-mono text-mono-md text-on-surface bg-surface-container-low border border-outline rounded-md focus:border-primary focus:ring-1 focus:ring-primary focus:bg-surface transition-colors duration-state-change ease-state-change" aria-label="Digit 2">
              <input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" data-otp-input="2" class="w-full aspect-square text-center font-mono text-mono-md text-on-surface bg-surface-container-low border border-outline rounded-md focus:border-primary focus:ring-1 focus:ring-primary focus:bg-surface transition-colors duration-state-change ease-state-change" aria-label="Digit 3">
              <input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" data-otp-input="3" class="w-full aspect-square text-center font-mono text-mono-md text-on-surface bg-surface-container-low border border-outline rounded-md focus:border-primary focus:ring-1 focus:ring-primary focus:bg-surface transition-colors duration-state-change ease-state-change" aria-label="Digit 4">
              <input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" data-otp-input="4" class="w-full aspect-square text-center font-mono text-mono-md text-on-surface bg-surface-container-low border border-outline rounded-md focus:border-primary focus:ring-1 focus:ring-primary focus:bg-surface transition-colors duration-state-change ease-state-change" aria-label="Digit 5">
              <input type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" data-otp-input="5" class="w-full aspect-square text-center font-mono text-mono-md text-on-surface bg-surface-container-low border border-outline rounded-md focus:border-primary focus:ring-1 focus:ring-primary focus:bg-surface transition-colors duration-state-change ease-state-change" aria-label="Digit 6">
