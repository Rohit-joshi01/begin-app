            <span class="material-symbols-outlined text-[20px]">person_add</span>
          </div>
          <span class="font-label text-label-md font-medium">Use another Google account</span>
        </button>
      </div>

      <!-- Custom Account Input Drawer (hidden by default) -->
      <form id="google-custom-form" hidden class="flex flex-col gap-2">
        <label for="google-custom-email" class="font-label text-label-sm text-on-surface-variant">Enter your Google email</label>
        <div class="flex gap-2">
          <input id="google-custom-email" type="email" placeholder="yourname@gmail.com" class="flex-1 min-w-0 px-3 py-2 rounded-md bg-surface text-on-surface border border-outline placeholder:text-on-surface-variant text-body-sm focus:border-primary focus:ring-1 focus:ring-primary">
          <button type="submit" class="px-4 py-2 rounded-md bg-primary text-on-primary font-label text-label-md hover:opacity-90">Continue</button>
        </div>
      </form>

      <!-- Status / Loader in modal -->
      <div id="google-modal-loading" hidden class="flex items-center justify-center gap-2 py-2 text-primary font-label text-label-md">
        <span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span>
        <span id="google-loading-text">Signing in with Google...</span>
      </div>

      <p class="font-body text-body-sm text-on-surface-variant text-[11px] leading-tight">
        To continue, Google will share your name and email address with Begin. Review Begin's Terms of Service and Privacy Policy.
      </p>
    </div>
  </div>

  <script>
    (function () {
      // Flow state
      let currentMode = '<%= purpose %>' === 'login' ? 'login' : 'signup';
      let currentEmail = '<%= email %>';
      let currentStep = Number('<%= initialStep %>') || 1;
      const urlRole = (new URLSearchParams(window.location.search).get('role') || '<%= typeof role !== "undefined" ? role : "" %>').toLowerCase();

      // DOM Elements: Step 1
      const tabSignup = document.getElementById('tab-signup');
      const tabLogin = document.getElementById('tab-login');
      const authHeading = document.getElementById('auth-heading');
      const authSubheading = document.getElementById('auth-subheading');
      const emailForm = document.getElementById('email-form');
      const collegeEmailInput = document.getElementById('college-email');
      const emailError = document.getElementById('email-error');
      const sendOtpBtn = document.getElementById('send-otp-btn');

      // DOM Elements: Step 2
      const step1Header = document.getElementById('step1-header');
      const step2Header = document.getElementById('step2-header');
      const step3Header = document.getElementById('step3-header');
      const step1View = document.getElementById('step1-view');
      const step2View = document.getElementById('step2-view');
      const step3View = document.getElementById('step3-view');
      const verifyChangeEmailBtn = document.getElementById('verify-change-email-btn');
      const verifyEmailTarget = document.getElementById('verify-email-target');
      const verifyForm = document.getElementById('verify-form');
      const otpInputs = Array.from(document.querySelectorAll('[data-otp-input]'));
      const otpError = document.getElementById('otp-error');
      const otpSuccess = document.getElementById('otp-success');
      const verifySubmitBtn = document.getElementById('verify-submit-btn');
      const resendBtn = document.getElementById('resend-btn');
      const resendLabel = document.getElementById('resend-label');

      // DOM Elements: Aside bottom
      const asideBottomLink = document.getElementById('aside-bottom-link');
      const asideBottomStatus = document.getElementById('aside-bottom-status');

      // DOM Elements: Step 3 (Profile & Live preview)
      const step3BackBtn = document.getElementById('step3-back-btn');
      const profileSecondaryBackBtn = document.getElementById('profile-secondary-back-btn');
      const navPillRole = document.getElementById('nav-pill-role');
      const profileForm = document.getElementById('profile-form');
      const profileError = document.getElementById('profile-error');
      const profileSuccess = document.getElementById('profile-success');
      const profileSubmitBtn = document.getElementById('profile-submit-btn');

      // Live Preview elements
      const nameInput = document.getElementById('full-name');
      const yearInput = document.getElementById('study-year');
      const branchInput = document.getElementById('study-branch');
      const previewName = document.getElementById('preview-name');
      const previewMeta = document.getElementById('preview-meta');
      const previewSkills = document.getElementById('preview-skills');
      const previewLooking = document.getElementById('preview-looking');
      const skillCount = document.getElementById('skill-count');
      const skillsGrid = document.getElementById('skills-grid');
      const skillSearch = document.getElementById('skill-search');
      const addCustomBtn = document.getElementById('add-custom-skill-btn');
      const lookingGrid = document.getElementById('looking-grid');
      const badgePercent = document.getElementById('badge-percent');
      const badgeBar = document.getElementById('badge-bar');

      // Helpers
      function showError(el, msg) {
        if (!el) return;
        const textSpan = el.querySelector('span:not(.material-symbols-outlined)') || el;
        textSpan.textContent = msg;
        el.removeAttribute('hidden');
      }

      function hideError(el) {
        if (!el) return;
        el.setAttribute('hidden', '');
      }

      // Step transition manager
      function goToStep(step) {
        currentStep = step;

        // Hide all views & headers first
        step1Header.setAttribute('hidden', '');
        step2Header.setAttribute('hidden', '');
        step3Header.setAttribute('hidden', '');
        step1View.setAttribute('hidden', '');
        step2View.setAttribute('hidden', '');
        step3View.setAttribute('hidden', '');

        if (step === 1) {
          step1Header.removeAttribute('hidden');
          step1View.removeAttribute('hidden');
          if (asideBottomLink) asideBottomLink.textContent = 'begin.college.edu/join';
          if (asideBottomStatus) asideBottomStatus.textContent = '38 builders online';
        } else if (step === 2) {
          step2Header.removeAttribute('hidden');
          step2View.removeAttribute('hidden');
          if (asideBottomLink) asideBottomLink.textContent = 'begin.college.edu/verify';
          if (asideBottomStatus) asideBottomStatus.textContent = '10m validity';
          setTimeout(() => {
            if (otpInputs[0]) otpInputs[0].focus();
          }, 150);
        } else if (step === 3) {
          step3Header.removeAttribute('hidden');
          step3View.removeAttribute('hidden');
          if (asideBottomLink) asideBottomLink.textContent = 'begin.college.edu/profile';
          if (asideBottomStatus) asideBottomStatus.textContent = 'Step 2 of 2';
          updateIdentityPreview();
          updateSkillsPreview();
          updateLookingPreview();
          applyRoleSettings();
          setTimeout(() => {
            if (nameInput) nameInput.focus();
          }, 150);
        }
      }

      // Tab switching between Sign up and Log in
      function setAuthMode(mode) {
        currentMode = mode;
        hideError(emailError);
        const googleBtnText = document.getElementById('google-btn-text');
        if (mode === 'signup') {
          tabSignup.setAttribute('aria-selected', 'true');
          tabSignup.className = 'flex-1 py-1.5 rounded-sm font-label text-label-md transition-colors duration-state-change ease-state-change bg-surface text-on-surface shadow-sm font-medium';
          tabLogin.setAttribute('aria-selected', 'false');
          tabLogin.className = 'flex-1 py-1.5 rounded-sm font-label text-label-md transition-colors duration-state-change ease-state-change text-on-surface-variant hover:text-on-surface';
          authHeading.textContent = 'Create your student builder account';
          authSubheading.textContent = 'Use your Gmail or email address to get started.';
          if (googleBtnText) googleBtnText.textContent = 'Sign up with Google';
        } else {
          tabLogin.setAttribute('aria-selected', 'true');
          tabLogin.className = 'flex-1 py-1.5 rounded-sm font-label text-label-md transition-colors duration-state-change ease-state-change bg-surface text-on-surface shadow-sm font-medium';
          tabSignup.setAttribute('aria-selected', 'false');
          tabSignup.className = 'flex-1 py-1.5 rounded-sm font-label text-label-md transition-colors duration-state-change ease-state-change text-on-surface-variant hover:text-on-surface';
          authHeading.textContent = 'Log in to Begin';
          authSubheading.textContent = 'Enter your email to receive a sign-in code.';
          if (googleBtnText) googleBtnText.textContent = 'Log in with Google';
        }
      }

      tabSignup.addEventListener('click', () => setAuthMode('signup'));
      tabLogin.addEventListener('click', () => setAuthMode('login'));

      // Check URL for error message
      const urlErrorParam = new URLSearchParams(window.location.search).get('error');
      if (urlErrorParam) {
        showError(emailError, decodeURIComponent(urlErrorParam));
      }

      // Email validation (accepts Gmail, college emails, and standard emails)
      const validEmailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/i;

      // Google Auth Modal & Flow Elements
      const googleAuthBtn = document.getElementById('google-auth-btn');
      const googleModal = document.getElementById('google-modal');
      const googleModalClose = document.getElementById('google-modal-close');
      const googleModalTitle = document.getElementById('google-modal-title');
      const googleModalSubtitle = document.getElementById('google-modal-subtitle');
      const googleLoading = document.getElementById('google-modal-loading');
      const googleLoadingText = document.getElementById('google-loading-text');
      const googleAccBtns = document.querySelectorAll('.google-acc-btn');
      const googleUseCustomBtn = document.getElementById('google-use-custom-btn');
      const googleCustomForm = document.getElementById('google-custom-form');
      const googleCustomEmail = document.getElementById('google-custom-email');

      function openGoogleModal() {
        if (!googleModal) return;
        const isLogin = currentMode === 'login';
        if (googleModalTitle) googleModalTitle.textContent = isLogin ? 'Log in with Google' : 'Sign up with Google';
        if (googleModalSubtitle) googleModalSubtitle.textContent = 'Choose an account to continue to Begin';
        if (googleLoading) googleLoading.setAttribute('hidden', '');
        if (googleCustomForm) googleCustomForm.setAttribute('hidden', '');
        googleModal.removeAttribute('hidden');
      }

      function closeGoogleModal() {
        if (googleModal) googleModal.setAttribute('hidden', '');
      }

      // Google Identity Services (GSI) Real Browser Account Integration
      const googleClientId = '<%= typeof googleClientId !== "undefined" ? googleClientId : "" %>';

      function initGoogleIdentity() {
        if (!googleClientId) return;

        function trySetupGSI() {
          if (!window.google || !window.google.accounts || !window.google.accounts.id) {
            setTimeout(trySetupGSI, 250);
            return;
          }

          try {
            google.accounts.id.initialize({
              client_id: googleClientId,
              callback: (response) => {
                if (!response || !response.credential) return;
                try {
                  const payload = parseJwt(response.credential);
                  if (payload && payload.email) {
                    proceedWithGoogleAuth(payload.email, payload.name || '');
                  }
                } catch (err) {
                  console.error('Google token decode error:', err);
                }
              },
              auto_select: false,
              cancel_on_tap_outside: true,
            });

            // Render Google's native button which automatically pulls accounts from user's browser session
            const gsiContainer = document.getElementById('g_id_signin');
            if (gsiContainer) {
              google.accounts.id.renderButton(gsiContainer, {
                type: 'standard',
                theme: 'outline',
                size: 'large',
                text: currentMode === 'login' ? 'signin_with' : 'signup_with',
                shape: 'rectangular',
                logo_alignment: 'left',
                width: 380,
              });
              // When official Google button is active, hide fallback
              if (googleAuthBtn) googleAuthBtn.setAttribute('hidden', '');
            }

            // Also trigger One Tap prompt on page load
            google.accounts.id.prompt();
          } catch (e) {
            console.warn('Google Identity initialization failed:', e);
          }
        }

        trySetupGSI();
      }

      function parseJwt(token) {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(
          atob(base64)
            .split('')
            .map((c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
        return JSON.parse(jsonPayload);
      }

      function proceedWithGoogleAuth(email, fullName) {
        if (!email) return;
        if (googleLoading) {
          googleLoading.removeAttribute('hidden');
          if (googleLoadingText) {
            googleLoadingText.textContent = (currentMode === 'login' ? 'Logging in as ' : 'Creating account for ') + (fullName || email) + '...';
          }
        }
        setTimeout(() => {
          window.location.href = '/auth/google?email=' + encodeURIComponent(email) +
            '&fullName=' + encodeURIComponent(fullName || '') +
            '&purpose=' + encodeURIComponent(currentMode);
        }, 300);
      }

      if (googleAuthBtn) {
        googleAuthBtn.addEventListener('click', () => {
          const typedEmail = (collegeEmailInput.value || '').trim();
          if (typedEmail && validEmailRegex.test(typedEmail)) {
            proceedWithGoogleAuth(typedEmail, typedEmail.split('@')[0]);
          } else {
            openGoogleModal();
          }
        });
      }

      if (googleModalClose) {
        googleModalClose.addEventListener('click', closeGoogleModal);
      }

      if (googleModal) {
        googleModal.addEventListener('click', (e) => {
          if (e.target === googleModal) closeGoogleModal();
        });
      }

      googleAccBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const accEmail = btn.getAttribute('data-google-account');
          const accName = btn.getAttribute('data-google-name');
          proceedWithGoogleAuth(accEmail, accName);
        });
      });

      if (googleUseCustomBtn) {
        googleUseCustomBtn.addEventListener('click', () => {
          if (googleCustomForm) {
            const isHidden = googleCustomForm.hasAttribute('hidden');
            if (isHidden) {
              googleCustomForm.removeAttribute('hidden');
              googleCustomEmail.focus();
            } else {
              googleCustomForm.setAttribute('hidden', '');
            }
          }
        });
      }

      if (googleCustomForm) {
        googleCustomForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const emailVal = (googleCustomEmail.value || '').trim();
          if (!emailVal || !validEmailRegex.test(emailVal)) {
            alert('Please enter a valid Google email address (e.g. you@gmail.com)');
            googleCustomEmail.focus();
            return;
          }
          proceedWithGoogleAuth(emailVal, emailVal.split('@')[0]);
        });
      }

      emailForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError(emailError);

        const val = (collegeEmailInput.value || '').trim();
        if (!val) {
          showError(emailError, 'Please enter your email address.');
          collegeEmailInput.focus();
          return;
        }

        if (!validEmailRegex.test(val)) {
          showError(emailError, 'Please enter a valid email address (e.g. you@gmail.com).');
          collegeEmailInput.focus();
          return;
        }

        const originalBtnHtml = sendOtpBtn.innerHTML;
        sendOtpBtn.disabled = true;
        sendOtpBtn.classList.add('opacity-70');
        sendOtpBtn.innerHTML = '<span>Sending code...</span>';

        try {
          const res = await fetch('/auth/request-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: val, purpose: currentMode })
          });
          const data = await res.json();

          if (!res.ok || !data.success) {
            showError(emailError, data.message || 'Unable to send OTP. Please check your email.');
            return;
          }

          currentEmail = val;
          verifyEmailTarget.textContent = val;

          // Clear previous OTP entries
          otpInputs.forEach((inp) => {
            inp.value = '';
            inp.classList.remove('bg-surface');
            inp.classList.add('bg-surface-container-low');
          });

          hideError(otpError);
          startResendCountdown(30);
          goToStep(2);

          if (window.history && window.history.pushState) {
            window.history.pushState({}, '', '/verify?email=' + encodeURIComponent(val) + '&purpose=' + encodeURIComponent(currentMode));
          }
        } catch {
          showError(emailError, 'Connection error. Please try again.');
        } finally {
          sendOtpBtn.disabled = false;
          sendOtpBtn.classList.remove('opacity-70');
          sendOtpBtn.innerHTML = originalBtnHtml;
        }
      });

      // Step 2: Change email button
      verifyChangeEmailBtn.addEventListener('click', () => {
        goToStep(1);
        collegeEmailInput.focus();
      });

      // Step 2: Resend Countdown Timer
      let countdownTimer = null;
      function startResendCountdown(seconds) {
        if (countdownTimer) clearInterval(countdownTimer);
        let left = seconds;
        resendBtn.disabled = true;

        const update = () => {
          const m = Math.floor(left / 60);
          const s = String(left % 60).padStart(2, '0');
          resendLabel.textContent = 'Resend code in ' + m + ':' + s;
          if (left <= 0) {
            clearInterval(countdownTimer);
            resendBtn.disabled = false;
            resendLabel.textContent = 'Resend code';
          }
          left--;
        };

        update();
        countdownTimer = setInterval(update, 1000);
      }

      resendBtn.addEventListener('click', async () => {
        if (resendBtn.disabled || !currentEmail) return;
        hideError(otpError);
        resendBtn.disabled = true;
        resendLabel.textContent = 'Sending...';

        try {
          const res = await fetch('/auth/request-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: currentEmail, purpose: currentMode })
          });
          const data = await res.json();
          if (data.success) {
            startResendCountdown(30);
          } else {
            showError(otpError, data.message || 'Failed to resend code');
            resendBtn.disabled = false;
            resendLabel.textContent = 'Resend code';
          }
        } catch {
          showError(otpError, 'Network error. Try again.');
          resendBtn.disabled = false;
          resendLabel.textContent = 'Resend code';
        }
      });

      // Step 2: OTP Input handling (typing, arrow keys, paste)
      otpInputs.forEach((input, idx) => {
        input.addEventListener('input', (e) => {
          hideError(otpError);
          const cleaned = e.target.value.replace(/\D/g, '');
          e.target.value = cleaned.slice(-1);
          if (cleaned) {
            input.classList.remove('bg-surface-container-low');
            input.classList.add('bg-surface');
            if (idx < otpInputs.length - 1) {
              otpInputs[idx + 1].focus();
            }
          } else {
            input.classList.remove('bg-surface');
            input.classList.add('bg-surface-container-low');
          }
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !input.value && idx > 0) {
            otpInputs[idx - 1].focus();
          }
          if (e.key === 'Enter') {
            e.preventDefault();
            verifyForm.requestSubmit();
          }
        });

        input.addEventListener('paste', (e) => {
          e.preventDefault();
          const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
          if (!pasted) return;
          pasted.split('').forEach((char, i) => {
            if (otpInputs[i]) {
              otpInputs[i].value = char;
              otpInputs[i].classList.remove('bg-surface-container-low');
              otpInputs[i].classList.add('bg-surface');
            }
          });
          const nextIdx = Math.min(pasted.length, otpInputs.length - 1);
          otpInputs[nextIdx].focus();
          hideError(otpError);
        });
      });

      // Step 2 Submit: Verify OTP and transition IMMEDIATELY to Step 3 (Profile replica of code (2).html)
      verifyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = otpInputs.map((i) => i.value).join('');
        if (code.length < 6) {
          showError(otpError, 'Please enter all 6 digits.');
          return;
        }

        hideError(otpError);
        const originalVerifyHtml = verifySubmitBtn.innerHTML;
        verifySubmitBtn.disabled = true;
        verifySubmitBtn.classList.add('opacity-70');
        verifySubmitBtn.innerHTML = '<span>Verifying...</span>';

        try {
          const res = await fetch('/auth/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: currentEmail, otp: code, purpose: currentMode })
          });
          const data = await res.json();

          if (!res.ok || !data.success) {
            showError(otpError, data.message || 'That code is incorrect or expired.');
            return;
          }

          if (otpSuccess) {
            otpSuccess.removeAttribute('hidden');
          }

          // Redirect directly to the newly created role page & route
          setTimeout(() => {
            if (otpSuccess) otpSuccess.setAttribute('hidden', '');
            window.location.href = '/role?email=' + encodeURIComponent(currentEmail);
          }, 600);

        } catch {
          showError(otpError, 'Connection error. Please try again.');
        } finally {
          verifySubmitBtn.disabled = false;
          verifySubmitBtn.classList.remove('opacity-70');
          verifySubmitBtn.innerHTML = originalVerifyHtml;
        }
      });


      // =========================================================================
      // STEP 3 LOGIC: Live Preview & Profile Form (from code (2).html)            
      // =========================================================================

      // Back buttons in Step 3
      if (step3BackBtn) {
        step3BackBtn.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.href = '/role?email=' + encodeURIComponent(currentEmail);
        });
      }
      if (profileSecondaryBackBtn) {
        profileSecondaryBackBtn.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.href = '/role?email=' + encodeURIComponent(currentEmail);
        });
      }
      if (navPillRole) {
        navPillRole.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.href = '/role?email=' + encodeURIComponent(currentEmail);
        });
      }

      function calculateProfileCompletion() {
        let total = 0;
        const isJoiner = (urlRole === 'joiner');

        // 1. Full name: 20%
        const name = (nameInput.value || '').trim();
        if (name.length > 0) total += 20;

        // 2. Year: 15% (20% for joiner)
        const year = (yearInput.value || '').trim();
        if (year.length > 0) total += (isJoiner ? 20 : 15);

        // 3. Department / Branch: 15% (20% for joiner)
        const branch = (branchInput.value || '').trim();
        if (branch.length > 0) total += (isJoiner ? 20 : 15);

        // 4. Skills: up to 25% (1 skill: 10%, 2 skills: 18%, 3+ skills: 25%)
        const selectedSkills = skillsGrid.querySelectorAll('[data-skill][aria-pressed="true"]').length;
        if (selectedSkills >= 3) {
          total += 25;
        } else if (selectedSkills === 2) {
          total += 18;
        } else if (selectedSkills === 1) {
          total += 10;
        }

        // 5. What are you looking for: 15%
        const selectedLooking = lookingGrid.querySelectorAll('[data-looking][aria-pressed="true"]').length;
        if (selectedLooking > 0) total += 15;

        // 6. Role / Startup Stage: 10% (Founder / Both only)
        if (!isJoiner) {
          const stageChecked = profileForm.querySelector('input[name="startup-stage"]:checked');
          if (stageChecked) total += 10;
        }

        total = Math.min(100, Math.max(0, total));
        badgePercent.textContent = total + '%';
        badgeBar.style.width = total + '%';
        const progressEl = badgeBar.parentElement;
        if (progressEl) progressEl.setAttribute('aria-valuenow', String(total));
        return total;
      }

      function updateIdentityPreview() {
        const name = (nameInput.value || '').trim() || 'Your Name';
        const year = (yearInput.value || '').trim();
        const branch = (branchInput.value || '').trim();
        previewName.textContent = name;
        if (year && branch) {
          previewMeta.textContent = year + ' · ' + branch;
        } else if (year || branch) {
          previewMeta.textContent = year || branch;
        } else {
          previewMeta.textContent = 'Year · Branch';
        }
        calculateProfileCompletion();
      }

      function updateSkillsPreview() {
        const selected = Array.from(skillsGrid.querySelectorAll('[data-skill][aria-pressed="true"]'))
          .map((btn) => btn.getAttribute('data-skill'));
        skillCount.textContent = selected.length + ' of 8 selected';
        previewSkills.innerHTML = '';
        selected.forEach((s) => {
          const span = document.createElement('span');
          span.className = 'px-2 py-0.5 rounded-md bg-surface border border-outline text-on-surface font-label text-label-sm';
          span.setAttribute('data-design-text-token', 'label-sm');
          span.textContent = s;
          previewSkills.appendChild(span);
        });
        calculateProfileCompletion();
      }

      function updateLookingPreview() {
        const selected = Array.from(lookingGrid.querySelectorAll('[data-looking][aria-pressed="true"]'))
          .map((btn) => btn.getAttribute('data-looking'));
        previewLooking.textContent = selected.length ? 'Looking for: ' + selected.join(', ') : 'Looking for: Open to opportunities';
        calculateProfileCompletion();
      }

      function bindSkillButton(btn) {
        btn.addEventListener('click', () => {
          const isPressed = btn.getAttribute('aria-pressed') === 'true';
          const selectedCount = skillsGrid.querySelectorAll('[data-skill][aria-pressed="true"]').length;
          if (!isPressed && selectedCount >= 8) return;
          btn.setAttribute('aria-pressed', isPressed ? 'false' : 'true');
          if (isPressed) {
            btn.className = 'px-3 py-1.5 rounded-md bg-surface text-on-surface-variant border border-outline hover:text-on-surface hover:border-outline-variant font-label text-label-md transition-colors duration-state-change ease-state-change';
          } else {
            btn.className = 'px-3 py-1.5 rounded-md bg-primary text-on-primary font-label text-label-md transition-colors duration-state-change ease-state-change';
          }
          updateSkillsPreview();
        });
      }

      skillsGrid.querySelectorAll('[data-skill]').forEach(bindSkillButton);

      lookingGrid.querySelectorAll('[data-looking]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isPressed = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', isPressed ? 'false' : 'true');
          if (isPressed) {
            btn.className = 'px-3.5 py-1.5 rounded-md bg-surface text-on-surface-variant border border-outline hover:text-on-surface hover:border-outline-variant font-label text-label-md transition-colors duration-state-change ease-state-change';
          } else {
            btn.className = 'px-3.5 py-1.5 rounded-md bg-primary text-on-primary font-label text-label-md transition-colors duration-state-change ease-state-change';
          }
          updateLookingPreview();
        });
      });

      addCustomBtn.addEventListener('click', () => {
        const val = (skillSearch.value || '').trim();
        if (!val) {
          skillSearch.focus();
          return;
        }
        const selectedCount = skillsGrid.querySelectorAll('[data-skill][aria-pressed="true"]').length;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-skill', val);
        const activate = selectedCount < 8;
        btn.setAttribute('aria-pressed', activate ? 'true' : 'false');
        btn.className = activate
          ? 'px-3 py-1.5 rounded-md bg-primary text-on-primary font-label text-label-md transition-colors duration-state-change ease-state-change'
          : 'px-3 py-1.5 rounded-md bg-surface text-on-surface-variant border border-outline hover:text-on-surface hover:border-outline-variant font-label text-label-md transition-colors duration-state-change ease-state-change';
        btn.innerHTML = '<span data-design-text-token="label-md"></span>';
        btn.querySelector('span').textContent = val;
        bindSkillButton(btn);
        skillsGrid.appendChild(btn);
        skillSearch.value = '';
        updateSkillsPreview();
      });

      [nameInput, yearInput, branchInput].forEach((el) => {
        el.addEventListener('input', updateIdentityPreview);
      });

      profileForm.querySelectorAll('input[name="startup-stage"]').forEach((radio) => {
        radio.addEventListener('change', calculateProfileCompletion);
      });

      // Role detection & dynamic startup-stage hiding
      const startupStageContainer = document.getElementById('startup-stage-container');
      const previewRoleBadge = document.getElementById('preview-role-badge');
      const previewRoleDot = document.getElementById('preview-role-dot');
      const previewRoleText = document.getElementById('preview-role-text');

      function applyRoleSettings() {
        if (urlRole === 'joiner') {
          if (startupStageContainer) startupStageContainer.setAttribute('hidden', '');
          if (previewRoleBadge) {
            previewRoleBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-accent-emerald-bg text-accent-emerald font-mono text-label-sm shrink-0';
          }
          if (previewRoleDot) previewRoleDot.className = 'w-1.5 h-1.5 rounded-full bg-accent-emerald';
          if (previewRoleText) previewRoleText.textContent = 'Open to join';
        } else if (urlRole === 'founder') {
          if (startupStageContainer) startupStageContainer.removeAttribute('hidden');
          if (previewRoleBadge) {
            previewRoleBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-accent-violet-bg text-accent-violet font-mono text-label-sm shrink-0';
          }
          if (previewRoleDot) previewRoleDot.className = 'w-1.5 h-1.5 rounded-full bg-accent-violet';
          if (previewRoleText) previewRoleText.textContent = 'Founder';
        } else if (urlRole === 'both') {
          if (startupStageContainer) startupStageContainer.removeAttribute('hidden');
          if (previewRoleBadge) {
            previewRoleBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-accent-amber-bg text-on-accent-amber font-mono text-label-sm shrink-0';
          }
          if (previewRoleDot) previewRoleDot.className = 'w-1.5 h-1.5 rounded-full bg-accent-amber';
          if (previewRoleText) previewRoleText.textContent = 'Founder & Joiner';
        } else {
          if (startupStageContainer) startupStageContainer.removeAttribute('hidden');
        }
      }

      // Profile Submit -> Save to MongoDB
      profileForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError(profileError);

        const fullName = (nameInput.value || '').trim();
        const year = (yearInput.value || '').trim();
        const branch = (branchInput.value || '').trim();

        if (!fullName) {
          showError(profileError, 'Please enter your full name.');
          nameInput.focus();
          return;
        }

        const selectedSkills = Array.from(skillsGrid.querySelectorAll('[data-skill][aria-pressed="true"]'))
          .map((b) => b.getAttribute('data-skill'));

        if (selectedSkills.length < 1) {
          showError(profileError, 'Please select at least 1 skill (recommended 3 to 8).');
          return;
        }

        const selectedLooking = Array.from(lookingGrid.querySelectorAll('[data-looking][aria-pressed="true"]'))
          .map((b) => b.getAttribute('data-looking'));

        const stageInput = profileForm.querySelector('input[name="startup-stage"]:checked');
        const startupStage = (urlRole === 'joiner') ? 'N/A' : (stageInput ? stageInput.value : 'Idea');
        const roleToSave = (urlRole && ['founder', 'joiner', 'both'].includes(urlRole)) ? urlRole : 'founder';

        const originalBtnHtml = profileSubmitBtn.innerHTML;
        profileSubmitBtn.disabled = true;
        profileSubmitBtn.classList.add('opacity-70');
        profileSubmitBtn.innerHTML = '<span>Saving profile...</span>';

        try {
          const res = await fetch('/auth/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: currentEmail,
              fullName,
              year,
              branch,
              role: roleToSave,
              skills: selectedSkills,
              lookingFor: selectedLooking,
              startupStage
            })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            showError(profileError, data.message || 'Unable to save profile. Please try again.');
            return;
          }

          if (profileSuccess) {
            profileSuccess.removeAttribute('hidden');
          }

        } catch {
          showError(profileError, 'Connection error while saving profile.');
        } finally {
          profileSubmitBtn.disabled = false;
          profileSubmitBtn.classList.remove('opacity-70');
          profileSubmitBtn.innerHTML = originalBtnHtml;
        }
      });

      // Initialize initial step & view
      goToStep(currentStep);
      setAuthMode(currentMode);
      applyRoleSettings();
      initGoogleIdentity();

    })();
  </script>
</body>
</html>
