MONGO_URI=mongodb://localhost:27017/begin_db
PORT=8000

# Secret used to HMAC-hash OTPs before storing in DB (use any long random string)
OTP_SECRET=change_me_to_a_long_random_secret_string

# Google OAuth Client ID (from Google Cloud Console to list device Google accounts)
GOOGLE_CLIENT_ID=

# SMTP settings — use Gmail app password, Ethereal, Brevo, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
